---
layout: null
---
{% assign releases = site.data.sumthumb.releases %}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/" version="2.0">
    <channel>
        <title>Sum-Thumb Updates</title>
        <language>ko</language>
{% for release in releases %}
        <item>
            <title>{{ release.version }}</title>
            <pubDate>{{ release.pub_date }}</pubDate>
            <sparkle:version>{{ release.build }}</sparkle:version>
            <sparkle:shortVersionString>{{ release.version }}</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>{{ release.minimum_system_version }}</sparkle:minimumSystemVersion>
{% if forloop.first %}
            <sparkle:releaseNotesLink>{{ '/apps/sumthumb/release-notes/' | absolute_url }}</sparkle:releaseNotesLink>
{% else %}
            <sparkle:releaseNotesLink>{{ release.release_notes_path | absolute_url }}</sparkle:releaseNotesLink>
{% endif %}
            <enclosure url="{{ release.download_path | absolute_url }}" length="{{ release.download_length }}" type="application/octet-stream" sparkle:edSignature="{{ release.signature }}"/>
        </item>
{% endfor %}
    </channel>
</rss>
